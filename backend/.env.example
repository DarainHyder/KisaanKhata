# KisaanKhata — Environment Variables Example
# =============================================
# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and should never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default is a local SQLite file — no changes needed for local development.
# For production you could switch to PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/kisaankhata
DATABASE_URL=sqlite:///./kisaankhata.db

# ---------------------------------------------------------------------------
# Whisper (Speech-to-Text)
# ---------------------------------------------------------------------------
# Model size — larger models are more accurate but slower and use more RAM.
# Options: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=small

# Language hint for Whisper. "ur" = Urdu. Whisper also understands Punjabi
# and Sindhi when set to auto-detect ("").
WHISPER_LANGUAGE=ur

# ---------------------------------------------------------------------------
# App settings (optional)
# ---------------------------------------------------------------------------
# Set to "production" to disable debug output in logs.
APP_ENV=development

# ---------------------------------------------------------------------------
# Twilio — SMS / WhatsApp interface
# ---------------------------------------------------------------------------
# Sign up free at https://www.twilio.com/try-twilio
# Find these values in the Twilio Console → Account Dashboard.
#
# FREE TRIAL NOTE:
#   - Twilio trial accounts can only send to verified phone numbers.
#   - Add test numbers at: https://console.twilio.com/us1/develop/phone-numbers/manage/verified
#   - For WhatsApp sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
#   - Outgoing number format: +923001234567 (international format with +)
#
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Set to "true" to skip Twilio send and print to logs instead (for offline dev/testing)
TWILIO_DRY_RUN=false
